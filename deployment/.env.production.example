# TaskPilot AI — production environment. Copy to deployment/.env.production (never commit the copy).
# Every CHANGE_ME must be replaced. The API refuses to start with an unsafe production configuration.

APP_ENV=production
LOG_LEVEL=INFO
TASKPILOT_VERSION=1.0.0

# Public origin served by nginx (TLS). Used for CORS, cookies and the frontend build.
PUBLIC_BASE_URL=https://taskpilot.example.com
PUBLIC_WS_BASE_URL=wss://taskpilot.example.com
CORS_ORIGINS=https://taskpilot.example.com
TLS_CERT_DIR=./nginx/certs

# ---------------------------------------------------------------- database / redis
POSTGRES_DB=taskpilot
POSTGRES_USER=taskpilot
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
DATABASE_URL=postgresql+asyncpg://taskpilot:CHANGE_ME_long_random_password@postgres:5432/taskpilot
DATABASE_AUTO_CREATE=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

REDIS_PASSWORD=CHANGE_ME_long_random_password
REDIS_URL=redis://:CHANGE_ME_long_random_password@redis:6379/0
QUEUE_BACKEND=redis
QUEUE_MAX_DEPTH=200
QUEUE_MAX_ATTEMPTS=3
RECOVERY_ON_STARTUP=true

# ---------------------------------------------------------------- authentication
AUTH_MODE=local
AUTH_REQUIRED=true
ALLOW_DEV_AUTH_BYPASS=false
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=CHANGE_ME_at_least_32_random_characters
JWT_ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_MIN_LENGTH=12
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
CSRF_PROTECTION_ENABLED=true
# Disable open registration once the team is set up.
REGISTRATION_ENABLED=false
# First OWNER account, created only if no user exists. Remove the password after first start.
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME_strong_password

# ---------------------------------------------------------------- safety switches (validated at startup)
ENABLE_DEMO_ENDPOINTS=false
BROWSER_PERSIST_SESSIONS=false
REQUIRE_EGRESS_PROXY=true
EGRESS_PROXY_URL=http://egress:3128
RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------- rate limits
API_RATE_LIMIT_PER_MINUTE=120
AUTH_LOGIN_ATTEMPTS_PER_MINUTE=5
LLM_REQUESTS_PER_MINUTE=30
PLANNING_REQUESTS_PER_MINUTE=20
BROWSER_ACTIONS_PER_MINUTE=120
COMMERCE_SEARCHES_PER_MINUTE=20
FILE_DOWNLOADS_PER_HOUR=20
MAX_WEBSOCKET_CONNECTIONS_PER_USER=5

# ---------------------------------------------------------------- LLM (secrets: server-side only)
AGENT_PROVIDER=anthropic
ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-opus-5-5
LLM_DAILY_TOKEN_BUDGET=2000000
# Your contracted prices (USD per million tokens) — used only for cost reporting.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# ---------------------------------------------------------------- files / scanning / observability
FILE_STORAGE_QUOTA_MB_PER_USER=200
FILE_MAX_COUNT_PER_USER=200
# none -> downloads are marked SCAN_UNAVAILABLE; clamav requires `--profile scanning`.
MALWARE_SCANNER=none
METRICS_ENABLED=true
METRICS_TOKEN=CHANGE_ME_random_token
AUDIT_RETENTION_DAYS=365
