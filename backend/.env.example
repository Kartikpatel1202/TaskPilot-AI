APP_NAME=TaskPilot AI
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
ENABLE_DEMO_ENDPOINTS=true
MAX_COMMAND_LENGTH=4000
WEBSOCKET_MAX_CONNECTIONS=10
TELEMETRY_HISTORY_LIMIT=500

# Optional (defaults shown)
# ASSISTANT_NAME=Kamlesh Bhai
# WEBSOCKET_SEND_QUEUE_SIZE=256
# WEBSOCKET_HEARTBEAT_SECONDS=25
# DEMO_EVENT_DELAY_MS=450
# DEMO_APPROVAL_TTL_SECONDS=120

# ---------------------------------------------------------------- Phase 2: agent
# Provider: auto (Anthropic or OpenAI when its key is set, else the clearly labelled offline planner) | mock | openai | anthropic
AGENT_PROVIDER=auto
# Optional model override. Leave empty to use OPENAI_MODEL / ANTHROPIC_MODEL.
AGENT_MODEL=

# Secrets — server-side only. Never put these in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# ANTHROPIC_SERVER_FALLBACKS=true

# LLM behaviour
AGENT_REQUEST_TIMEOUT_SECONDS=40
# Reasoning models think before answering; values far below ~16000 risk truncated plans.
AGENT_MAX_OUTPUT_TOKENS=16000
AGENT_MAX_RETRIES=2
AGENT_MAX_PLAN_STEPS=25

# Planning queue
PLANNER_CONCURRENCY=3
PLANNER_QUEUE_SIZE=50

# Session memory (in memory only; cleared on restart)
MEMORY_MAX_TURNS=20
MEMORY_MAX_CHARACTERS=12000
MEMORY_TTL_MINUTES=60
MEMORY_MAX_SESSIONS=1000

# Agent controls
AGENT_PLANNING_ENABLED=true
# Phase 3: true = plans can run in Chromium after an explicit "Run Plan" click.
AGENT_BROWSER_EXECUTION_ENABLED=true
# AGENT_ALLOW_MOCK_IN_PRODUCTION=false

# ---------------------------------------------------------------- Phase 3: browser execution
# Requires: pip install -r requirements.txt && python -m playwright install chromium
# Execution starts from an explicit "Run Plan" click, or automatically for low-risk voice requests when
# voice auto-run is enabled in Settings (plans with HIGH/CRITICAL or approval-gated steps never auto-start).
BROWSER_ENGINE=chromium
# false = a visible Chromium window opens on this machine during runs (development). Production stays headless.
BROWSER_HEADLESS=false
# proxy = Chromium makes its own requests through a guard proxy that checks every connection and redirect hop
# (needed for sites with bot protection such as Blinkit); route = legacy server-side re-fetch of each request.
BROWSER_NETWORK_GUARD=proxy
# Seconds to wait while a site shows a security check you can complete in the visible window (never solved by TaskPilot).
BROWSER_HUMAN_CHECK_WAIT_SECONDS=90
BROWSER_START_TIMEOUT_SECONDS=30
BROWSER_ACTION_TIMEOUT_MS=10000
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_MAX_SESSIONS=5
BROWSER_MAX_PAGES_PER_SESSION=3
BROWSER_SESSION_IDLE_TIMEOUT_MINUTES=30
BROWSER_VIEWPORT_WIDTH=1440
BROWSER_VIEWPORT_HEIGHT=900
# Live preview: bounded to <= 5 fps; JPEG frames, latest frame only.
BROWSER_SCREENSHOT_FPS=1
BROWSER_SCREENSHOT_QUALITY=55
BROWSER_MAX_FRAME_BYTES=300000
BROWSER_SELECTOR_MAX_ATTEMPTS=2
BROWSER_SELECTOR_MIN_CONFIDENCE=0.82
BROWSER_ACTION_MAX_RETRIES=1
# Top-level navigation allow-list (exact domain or real subdomain).
BROWSER_ALLOWED_DOMAINS=blinkit.com,amazon.in,youtube.com,google.com
# DEVELOPMENT/TEST ONLY (rejected unless APP_ENV is development or test):
# exact local origins the browser may open, and the local demo-shop fixture.
BROWSER_TEST_ALLOWED_ORIGINS=
BROWSER_DEV_FIXTURES_ENABLED=false
# Persisted browser state is Fernet-encrypted; persistence is off by default.
# Generate a key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROWSER_PERSIST_SESSIONS=false
BROWSER_STATE_ENCRYPTION_KEY=
BROWSER_STATE_DIRECTORY=./runtime/browser_state

# Execution engine
EXECUTION_QUEUE_SIZE=20
EXECUTION_CONCURRENCY=3
EXECUTION_MAX_TASKS_PER_SESSION=1
EXECUTION_APPROVAL_TTL_SECONDS=300

# ---------------------------------------------------------------- Phase 4: commerce (Blinkit / Amazon India)
COMMERCE_ENABLED=true
COMMERCE_SUPPORTED_PLATFORMS=BLINKIT,AMAZON_IN
COMMERCE_MAX_PRODUCTS_PER_TASK=20
COMMERCE_MAX_SEARCH_RESULTS=30
# Deterministic product matching (acceptable must not exceed exact).
COMMERCE_EXACT_MATCH_THRESHOLD=0.92
COMMERCE_ACCEPTABLE_MATCH_THRESHOLD=0.80
COMMERCE_AMBIGUITY_MARGIN=0.05
COMMERCE_MAX_PACKS_PER_ITEM=6
# Any price change is disclosed; above this % it is flagged as significant. Never auto-accepted.
COMMERCE_MAX_PRICE_CHANGE_PERCENT=5
COMMERCE_SEARCH_TIMEOUT_SECONDS=20
COMMERCE_CART_VERIFICATION_TIMEOUT_SECONDS=15
COMMERCE_MAX_SEARCH_ATTEMPTS=3
COMMERCE_SELECTION_TIMEOUT_SECONDS=300

# Purchase controls. Final approval and cart verification cannot be disabled; automated prepaid
# payment is not supported (settings validation refuses other values).
COMMERCE_REQUIRE_FINAL_PURCHASE_APPROVAL=true
COMMERCE_ALLOW_COD_ORDER_AFTER_APPROVAL=true
COMMERCE_AUTOMATED_PREPAID_PAYMENT=false
COMMERCE_REQUIRE_CART_VERIFICATION=true

# DEVELOPMENT/TEST ONLY: local Blinkit-like / Amazon-like fixture shops ("fixture blinkit", "fixture amazon").
# Needs BROWSER_TEST_ALLOWED_ORIGINS; rejected unless APP_ENV is development or test.
COMMERCE_ENABLE_FIXTURES=false
# Opt-in only; no automated public-site test runs by default.
COMMERCE_ENABLE_PUBLIC_SMOKE_TESTS=false

# ---------------------------------------------------------------- Phase 5: multi-domain integrations
# YouTube (search/play), Gmail (DRAFTS ONLY — sending is never automated), Google Calendar (exact-event
# approval before every create) and safe file downloads. TaskPilot never types passwords/OTPs/2FA codes:
# sign in yourself in the session browser when a site asks.
INTEGRATIONS_ENABLED=true
YOUTUBE_ENABLED=true
GMAIL_ENABLED=true
GOOGLE_CALENDAR_ENABLED=true
FILE_DOWNLOAD_ENABLED=true
INTEGRATION_ALLOWED_DOMAINS=www.youtube.com,youtube.com,youtu.be,mail.google.com,calendar.google.com
YOUTUBE_MAX_SEARCH_RESULTS=10
YOUTUBE_SEARCH_TIMEOUT_SECONDS=20
YOUTUBE_PLAYBACK_TIMEOUT_SECONDS=20
GMAIL_MAX_RECIPIENTS=20
GMAIL_MAX_DRAFT_LENGTH=12000
# Safety locks: the server refuses to start if either is true.
GMAIL_AUTOMATED_SEND_ENABLED=false
GMAIL_ATTACHMENT_ENABLED=false
CALENDAR_DEFAULT_TIMEZONE=Asia/Kolkata
# 0 = always ask how long an event should be (never guessed)
CALENDAR_DEFAULT_DURATION_MINUTES=0
CALENDAR_MAX_ATTENDEES=50
# Safety locks: approval is mandatory and automatic deletion is impossible.
CALENDAR_REQUIRE_CREATION_APPROVAL=true
CALENDAR_ALLOW_AUTOMATIC_EVENT_DELETION=false
FILE_DOWNLOAD_MAX_SIZE_MB=25
FILE_DOWNLOAD_MAX_CONCURRENT=2
FILE_DOWNLOAD_TTL_HOURS=24
FILE_DOWNLOAD_STORAGE=./runtime/downloads
FILE_DOWNLOAD_ALLOWED_EXTENSIONS=pdf,txt,csv,png,jpg,jpeg,webp,docx,xlsx,pptx
# Real downloads only from these domains (exact or subdomain). Empty = no real-site downloads.
FILE_DOWNLOAD_ALLOWED_DOMAINS=
# Safety locks: the server refuses to start if either is true.
FILE_DOWNLOAD_ALLOW_ARCHIVES=false
FILE_DOWNLOAD_ALLOW_EXECUTABLES=false
FILE_DOWNLOAD_MAX_STORAGE_MB=500
WORKFLOW_MAX_STEPS=30
WORKFLOW_MAX_DOMAINS=5
WORKFLOW_MAX_CONCURRENCY=2
WORKFLOW_TIMEOUT_SECONDS=300
# DEVELOPMENT/TEST ONLY: local YouTube-/Gmail-/Calendar-like fixtures and download test files
# ("fixture youtube", "fixture gmail", "fixture calendar", "fixture files"). Rejected outside development/test.
INTEGRATION_ENABLE_FIXTURES=false
